# Required: your Command Code API key (user_xxx).
# Can also be sent per request via Authorization: Bearer / x-api-key.
COMMANDCODE_API_KEY=

# Optional
PORT=3000
HOST=127.0.0.1
CC_BASE_URL=https://api.commandcode.ai
CC_VERSION=1.74.0

# Docker Compose: host-side publish port (bound to 127.0.0.1 only).
PROXY_PORT=3000

# Docker Compose requires this (container binds 0.0.0.0). Use >= 16 random chars.
# Local `npm start` on 127.0.0.1 can leave it empty.
# PROXY_AUTH_TOKEN=

# Empty / "none" = show every model (no plan filtering). "go" | "goat" | "pro" | "max".
CC_MODEL_FILTER=none

# Optional inbound auth: when set, every request except /health must send x-proxy-token.
# PROXY_AUTH_TOKEN=
# CORS_ALLOW_ORIGIN=

# Optional overrides
# CC_CATALOG_URL=https://unpkg.com/command-code@latest/dist/bundled/command-code-knowledge/reference/models.md
# CC_MODEL_REFRESH_MS=300000
# CC_MAX_BODY_MB=32
# CC_MAX_TOKENS=64000
# CC_DEFAULT_CONTEXT_WINDOW=262144
